# SeedLand · V (web) — environment variables
# Copy to .env and fill in the values before running `npm run dev`.

# ─── Database ─────────────────────────────────────────────────────────────
# Postgres connection string used by Prisma + the pg adapter.
#
# Option A — Prisma Dev (recommended for local dev, zero-install postgres):
#   $ npx prisma dev start seedlandv      # prints the actual TCP port
#   Then paste the printed `postgres://...` URL here.
#   Example (port will vary):
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# Option B — Docker compose at repo root (postgres:16 on :5432):
#   $ docker compose -f docker-compose.dev.yml up -d postgres
# DATABASE_URL="postgresql://seedlandv:seedlandv_dev@localhost:5432/seedlandv?schema=public"

# Option C — Any managed Postgres (Neon, Supabase, RDS, …):
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/DBNAME?schema=public&sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────
# HS256 signing secret for the seedland_session JWT cookie (jose).
# Generate a fresh one with:
#   $ node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-base64-32-byte-secret"

# ─── App ──────────────────────────────────────────────────────────────
# NODE_ENV is set automatically by Next.js (development / production).
# Only override if you know what you're doing.
# NODE_ENV="development"

# Public app metadata (exposed to client).
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_NAME="SeedLand · V"

# ─── Commerce (商业化扩展，接入时再填) ────────────────────────────────
# Stage 10.2 Mock provider — 用于跑通下单→checkout→webhook 全链路。
# 行为：
#   - 开发态 (NODE_ENV!=production)：默认启用，秘钥回退 "seedland-dev-mock-secret"。
#   - 生产态：必须显式 PAYMENT_MOCK_ENABLED=true + PAYMENT_MOCK_SECRET，否则模块加载抛错。
# 接入真实微信 / 支付宝（Stage 10.3）后，prod 请关掉 PAYMENT_MOCK_ENABLED。
# PAYMENT_MOCK_ENABLED="true"
# PAYMENT_MOCK_SECRET="generate-a-random-hex-string"

# 微信支付 v3（Stage 10.3）
# 完整 5 项配置全部填好后，registry 自动启用 wechatProvider；缺任一项 → 走 mock（或失败）。
# - APP_ID：商户绑定的小程序 / 公众号 / 应用 appid（Native 也需要）。
# - MCH_ID：商户号。
# - SERIAL_NO：apiclient_cert.pem 的 serial（hex 大写）。
# - API_V3_KEY：32 字节 utf8 的 APIv3 密钥（用于回调 AEAD_AES_256_GCM 解密）。
# - PRIVATE_KEY：apiclient_key.pem 文本（行内换行可用 \n 转义）。
# - PLATFORM_PUBLIC_KEY：微信平台公钥 PEM；缺失则无法验证回调，verifyWebhook 将拒签。
#   推荐用 PLATFORM_PUBLIC_KEYS（多证书 JSON）代替 — 微信约一年轮换一次平台证书，
#   并行窗口期间需同时持有新旧两把公钥。
# - PLATFORM_PUBLIC_KEYS（可选）：JSON 对象 `{"SERIAL_HEX": "PEM 字符串", ...}`。
#   配置后 verifyWebhook 会先按 Wechatpay-Serial 命中对应 key，失败回退「default」，
#   再失败遍历所有已知 key。
# - WECHAT_API_BASE（仅联调使用）：覆盖 https://api.mch.weixin.qq.com，用于本地 fake PSP。
#   生产环境不要设置。
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# WECHAT_PAY_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# WECHAT_PAY_PLATFORM_PUBLIC_KEYS='{"SERIAL_A":"-----BEGIN PUBLIC KEY-----\n...\n","SERIAL_B":"..."}'
# WECHAT_API_BASE=

# 支付宝（Stage 10.3，RSA2 签名）
# - APP_ID：开放平台应用 appid。
# - APP_PRIVATE_KEY：应用私钥（裸 base64 或 PEM 均可）。
# - PUBLIC_KEY：**支付宝公钥**（不是你自己上传的应用公钥），用于验签。
# - GATEWAY：可选，覆盖默认 gateway。
#   * 沙箱：https://openapi.alipaydev.com/gateway.do（NODE_ENV != production 默认值）
#   * 正式：https://openapi.alipay.com/gateway.do（production 默认值）
# - MERCHANT_TZ_OFFSET_MIN（可选，默认 480）：商户所在时区分钟数。
#   timestamp / time_expire 按此偏移转换到本地时间。境内商户 = 480 (+08:00)。
# ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=
# ALIPAY_MERCHANT_TZ_OFFSET_MIN=480

# Cron（Stage 10.3）
# 内部 cron 调用 /api/cron/expire-orders 时必带 `Authorization: Bearer $CRON_SECRET`。
# 未配置则 endpoint 403，相当于关闭。Endpoint 同时支持 GET / POST（Vercel Cron 默认 GET）。
# CRON_SECRET=

# 公开 base URL（Stage 10.3 strongly recommended）
# 用于构造 PSP 异步通知 URL（notify_url）。WeChat/Alipay 必须打到公网 HTTPS。
# 不配置时回退到 request Host，但 Host 可被伪造，且 cron 等无请求上下文时会 fallback 到 localhost。
# 生产部署 + 沙箱联调强烈建议显式配置。
# NEXT_PUBLIC_APP_URL=https://your.app
# PUBLIC_APP_URL=https://your.app  # 备用别名；NEXT_PUBLIC_APP_URL 优先

# Stripe（海外订阅，暂未启用）
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Storage / 第三方服务（按需启用）─────────────────────────────────
# Cloudflare R2（社群媒体上传，阶段 4）
# 1) R2 控制台 → 创建 bucket，记下 bucket 名
# 2) Manage R2 API Tokens → 创建带 Object Read & Write 权限的 token，
#    会得到 Access Key ID + Secret Access Key
# 3) Endpoint 形如 https://<account_id>.r2.cloudflarestorage.com
# 4) Public URL：开启 bucket 的 "R2.dev subdomain"（pub-xxx.r2.dev）
#    或绑定自定义域名（推荐 media.example.com，需在 Cloudflare DNS 配 CNAME）
# 5) CORS：在 bucket Settings → CORS 加入：
#    [{ "AllowedOrigins": ["https://your.app"],
#       "AllowedMethods": ["PUT"],
#       "AllowedHeaders": ["Content-Type"],
#       "MaxAgeSeconds": 3600 }]
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# STORAGE_PUBLIC_BASE_URL="https://media.example.com"

# AI 视频生成 API
# SEEDANCE_API_KEY=
# RUNWAY_API_KEY=
# ELEVENLABS_API_KEY=
