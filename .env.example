# SeedLand · V (web) — environment variables
# Copy to .env and fill in the values before running `npm run dev`.

# ─── Database ─────────────────────────────────────────────────────────────
# Postgres connection string used by Prisma + the pg adapter.
#
# Option A — Prisma Dev (recommended for local dev, zero-install postgres):
#   $ npx prisma dev start seedlandv      # prints the actual TCP port
#   Then paste the printed `postgres://...` URL here.
#   Example (port will vary):
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# Option B — Docker compose at repo root (postgres:16 on :5432):
#   $ docker compose -f docker-compose.dev.yml up -d postgres
# DATABASE_URL="postgresql://seedlandv:seedlandv_dev@localhost:5432/seedlandv?schema=public"

# Option C — Any managed Postgres (Neon, Supabase, RDS, …):
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/DBNAME?schema=public&sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────
# HS256 signing secret for the seedland_session JWT cookie (jose).
# Generate a fresh one with:
#   $ node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-base64-32-byte-secret"

# ─── App ──────────────────────────────────────────────────────────────
# NODE_ENV is set automatically by Next.js (development / production).
# Only override if you know what you're doing.
# NODE_ENV="development"

# Public app metadata (exposed to client).
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_NAME="SeedLand · V"

# ─── Commerce (商业化扩展，接入时再填) ────────────────────────────────
# 微信支付
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_KEY=

# 支付宝
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=

# Stripe（海外订阅）
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Storage / 第三方服务（按需启用）─────────────────────────────────
# Cloudflare R2（社群媒体上传，阶段 4）
# 1) R2 控制台 → 创建 bucket，记下 bucket 名
# 2) Manage R2 API Tokens → 创建带 Object Read & Write 权限的 token，
#    会得到 Access Key ID + Secret Access Key
# 3) Endpoint 形如 https://<account_id>.r2.cloudflarestorage.com
# 4) Public URL：开启 bucket 的 "R2.dev subdomain"（pub-xxx.r2.dev）
#    或绑定自定义域名（推荐 media.example.com，需在 Cloudflare DNS 配 CNAME）
# 5) CORS：在 bucket Settings → CORS 加入：
#    [{ "AllowedOrigins": ["https://your.app"],
#       "AllowedMethods": ["PUT"],
#       "AllowedHeaders": ["Content-Type"],
#       "MaxAgeSeconds": 3600 }]
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# STORAGE_PUBLIC_BASE_URL="https://media.example.com"

# AI 视频生成 API
# SEEDANCE_API_KEY=
# RUNWAY_API_KEY=
# ELEVENLABS_API_KEY=
