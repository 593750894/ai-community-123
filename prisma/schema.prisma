// SeedLand · V — AI 视频社群平台数据模型
// 详细文档：https://pris.ly/d/prisma-schema
//
// 设计原则
// 1. 所有主键使用 cuid。
// 2. 所有表都有 createdAt；可被修改的表带 updatedAt。
// 3. 用户密码只保存 passwordHash。
// 4. Like / Bookmark 通过可空外键实现多态（Post / Work），Like 额外支持 Comment。
// 5. Conversation 走 N:N 参与者表，可直接复用为一对一私信。
// 6. 字段命名 camelCase，库列名 snake_case。
// 7. 商业化扩展（会员、订单、工作流市场、企业账号）已预留 stub 模型。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═════════════════════════════════════════════════════════════════
//                              enums
// ═════════════════════════════════════════════════════════════════

enum Role {
  USER
  MOD
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum WorkModel {
  SEEDANCE_2_0
  SEEDANCE_FAST
}

enum WorkMode {
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  FIRST_LAST_FRAME
  MULTI_REFERENCE
}

enum WorkCategory {
  AI_COMIC // AI 漫剧
  AI_DRAMA // AI 短剧
  AI_ANIMATION // AI 动画
  DIGITAL_HUMAN // 数字人视频
  ECOMMERCE_AD // 电商广告视频
  PRODUCT_SHOW // 产品展示视频
  KNOWLEDGE // 知识讲解视频
  STORY // 故事类视频
  EXPERIMENT // 实验短片
}

enum CollaborationType {
  LOOKING_FOR // 我正在找
  OFFERING // 我可以提供
}

enum CollaborationStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum CollaborationCategory {
  AI_VIDEO_TEAM // 找 AI 视频制作团队
  AI_COMIC_CREATOR // 找 AI 漫剧创作者
  AI_DRAMA_TEAM // 找 AI 短剧团队
  DIGITAL_HUMAN // 找数字人制作
  PROMPT_ENGINEER // 找提示词工程师
  COMFYUI_WORKFLOW // 找 ComfyUI 工作流搭建
  EDITOR // 找剪辑师
  COFOUNDER // 找联合创始人
  INVEST_BIZ // 找投资 / 商务合作
  OTHER // 其他
}

enum CollaborationWorkMode {
  PROJECT // 项目制
  FULL_TIME // 全职
  PART_TIME // 兼职
  FREELANCE // 外包
  EQUITY // 合伙 / 股权
  ONE_OFF // 一次性单子
}

enum CollaborationLocation {
  REMOTE // 远程
  ONSITE // 线下
  HYBRID // 远程 + 线下
}

enum ToolPricing {
  FREE
  FREEMIUM
  PAID
}

enum PostType {
  DISCUSSION // 普通交流
  SHOWCASE // 作品展示
  COLLABORATION // 项目合作
  TOOL_RECOMMEND // 工具推荐
  TUTORIAL // 教程经验
  QUESTION // 提问求助
  NEWS // 行业资讯
}

enum NotificationType {
  POST_REPLY
  COMMENT_REPLY
  POST_LIKE
  WORK_LIKE
  COMMENT_LIKE
  BOOKMARK
  MENTION
  COLLAB_REPLY
  MESSAGE
  GROUP_MESSAGE // 阶段 12.4：群聊新消息（与 1v1 MESSAGE 分流，便于偏好分别关闭）
  FOLLOW
  SYSTEM
  ORDER_PAID // 阶段 10：买家订单付款成功
  WORKFLOW_SOLD // 阶段 10：卖家工作流被买入
  ORDER_REFUNDED // 阶段 10.4：买家订单退款成功（含全额 / 部分）
  PAYOUT_AVAILABLE // 阶段 10.5：冷藏期结束，结算单可申请提现
  PAYOUT_PAID // 阶段 10.5：admin 已完成线下打款
  ORG_INVITE // 阶段 11.1：被邀请加入企业
  ORG_INVITE_RESPONSE // 阶段 11.1：邀请被接受 / 拒绝（发送给邀请人）
  ORG_MEMBER_REMOVED // 阶段 11.1：被企业移除
  ORG_VERIFICATION_APPROVED // 阶段 11.2：企业认证通过
  ORG_VERIFICATION_REJECTED // 阶段 11.2：企业认证驳回
  CONTENT_REMOVED // 阶段 17.2：你的内容被审核者下架（含申诉入口）
  APPEAL_APPROVED // 阶段 17.2：申诉通过，内容已恢复
  APPEAL_REJECTED // 阶段 17.2：申诉被驳回（附驳回备注）
}

enum ReportTargetType {
  USER
  POST
  COMMENT
  WORK
  COLLABORATION
  MESSAGE
  TOOL
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum OrderType {
  MEMBERSHIP
  WORKFLOW_PURCHASE
  COLLABORATION_DEPOSIT
  CUSTOM
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
  FAILED
}

enum PayoutStatus {
  PENDING // 订单已付款，等待确认期结束
  AVAILABLE // 确认期已过，可结算
  PAID // 平台已打款给卖家
  CANCELED // 因订单退款而取消
}

enum RefundStatus {
  PENDING // 已创建未提交 PSP
  SUCCESS // PSP 已受理
  FAILED // PSP 拒绝
}

/// 阶段 16.4：Payout 已 PAID 后买家退款产生的应收（卖家欠平台）。
enum ClawbackStatus {
  PENDING // 等待 ops 处理
  DEDUCTED // 已从卖家未来某笔 payout 净额扣除
  MANUAL // 线下追回 / 协商（不走自动扣除）
  WAIVED // 平台决定吃下不追讨
}

enum PaymentMethod {
  WECHAT_PAY
  ALIPAY
  STRIPE
  MANUAL
}

enum WorkflowItemStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  ARCHIVED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

// Stage 11.2：企业认证状态。NONE = 从未提交；其他三个为申请生命周期。
enum OrgVerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// Stage 17.2：内容申诉适用的实体（仅可被软删除的内容类型，跨度比 Report 窄）。
enum ContentAppealTargetType {
  POST
  WORK
  COMMENT
  COLLABORATION
}

// Stage 17.2：申诉生命周期。
enum ContentAppealStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

// ═════════════════════════════════════════════════════════════════
//                           User & Auth
// ═════════════════════════════════════════════════════════════════

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  username     String     @unique
  name         String
  avatar       String?
  bio          String?
  passwordHash String     @map("password_hash")
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)

  // 个人主页字段
  industryRole   String?  @map("industry_role") // 行业角色，例如 "导演 / 编剧"
  expertise      String[] @default([]) // 擅长领域
  favoriteTools  String[] @default([]) @map("favorite_tools") // 常用 AI 视频工具
  portfolioLinks String[] @default([]) @map("portfolio_links")
  contact        String?

  // Stage 9：隐私 / 会话失效
  isProfilePublic  Boolean   @default(true) @map("is_profile_public")
  tokensValidAfter DateTime? @map("tokens_valid_after") // 早于此时间签发的 JWT 视为失效

  // Stage 17.5：禁言原因 / 期限 / 操作 admin 快照。
  // SUSPENDED 状态下用户仍可登录（read-only），suspendedUntil 到期由 cron 自动 ACTIVE。
  // BANNED / DELETED 是终态，不写这几列。
  suspensionReason  String?   @map("suspension_reason")
  suspendedUntil    DateTime? @map("suspended_until")
  suspendedAt       DateTime? @map("suspended_at")
  suspendedById     String?   @map("suspended_by_id")
  suspendedBy       User?     @relation("UserSuspender", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspensionsIssued User[]    @relation("UserSuspender")

  // Stage 10.5：卖家收款账号（提现绑定）。三个字段同时为空 = 未绑定。
  payoutMethod  String? @map("payout_method") // ALIPAY / WECHAT_PAY / BANK
  payoutAccount String? @map("payout_account") // 支付宝账号 / 微信号 / 银行卡号
  payoutName    String? @map("payout_name") // 收款人姓名（用于核对）

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 社区关系
  ownedChannels      Channel[]       @relation("ChannelOwner")
  channelMemberships ChannelMember[]
  posts              Post[]
  comments           Comment[]
  works              Work[]
  collaborations     Collaboration[]
  toolsContributed   Tool[]          @relation("ToolContributor")
  toolRatings        ToolRating[]

  // 私信
  conversations      ConversationParticipant[]
  messagesSent       Message[]                 @relation("MessageSender")
  // Stage 12.1：群聊群主
  conversationsOwned Conversation[]            @relation("ConversationOwner")

  // 互动
  likes     Like[]
  bookmarks Bookmark[]

  // 通知 / 举报 / 审计
  notificationsReceived  Notification[] @relation("NotificationRecipient")
  notificationsTriggered Notification[] @relation("NotificationActor")
  reportsFiled           Report[]       @relation("ReportReporter")
  reportsResolved        Report[]       @relation("ReportResolver")
  reportsAssigned        Report[]       @relation("ReportAssignee")
  auditLogs              AuditLog[]     @relation("AuditAdmin")

  // 关注关系（阶段 2）
  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  // Stage 9：通知偏好
  notificationPreferences NotificationPreference[]

  // 商业化扩展
  subscriptions           Subscription[]
  orders                  Order[]
  workflowItemsAsSeller   WorkflowItem[]       @relation("WorkflowItemSeller")
  payoutsAsSeller         Payout[]             @relation("PayoutSeller")
  refundsInitiated        Refund[]             @relation("RefundCreator")
  clawbacksAsSeller       ClawbackRequest[]    @relation("ClawbackSeller")
  clawbacksResolved       ClawbackRequest[]    @relation("ClawbackResolver")
  organizationMemberships OrganizationMember[]

  // Stage 11.1：企业 / Organization
  organizationsOwned      Organization[]       @relation("OrganizationOwner")
  organizationInvitesSent OrganizationInvite[] @relation("OrgInviteInviter")
  organizationInvitesGot  OrganizationInvite[] @relation("OrgInviteInvitee")

  // Stage 11.2：企业认证审核
  organizationsReviewed Organization[] @relation("OrgVerificationReviewer")

  // Stage 16.5：付费下载 redeem 审计
  downloadGrants DownloadGrant[] @relation("DownloadGrantUser")

  // Stage 17.2：软删除操作者反向关系（MOD/ADMIN 下架内容时填）
  postsDeleted          Post[]          @relation("PostDeleter")
  worksDeleted          Work[]          @relation("WorkDeleter")
  commentsDeleted       Comment[]       @relation("CommentDeleter")
  collaborationsDeleted Collaboration[] @relation("CollaborationDeleter")

  // Stage 17.2：内容申诉
  contentAppealsAuthored ContentAppeal[] @relation("AppealAppellant")
  contentAppealsReviewed ContentAppeal[] @relation("AppealReviewer")

  @@index([status])
  @@index([role])
  @@index([status, suspendedUntil]) // Stage 17.5: cron 查询 SUSPENDED + 到期
  @@map("users")
}

// ═════════════════════════════════════════════════════════════════
//                            Community
// ═════════════════════════════════════════════════════════════════

model Channel {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  banner      String?
  color       String   @default("#3b82f6")
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner   User            @relation("ChannelOwner", fields: [ownerId], references: [id])
  members ChannelMember[]
  posts   Post[]

  @@map("channels")
}

model ChannelMember {
  channelId String   @map("channel_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
  @@map("channel_members")
}

// ═════════════════════════════════════════════════════════════════
//                              Posts
// ═════════════════════════════════════════════════════════════════

model Post {
  id             String   @id @default(cuid())
  channelId      String   @map("channel_id")
  authorId       String   @map("author_id")
  // Stage 11.3：企业身份发布。null = 个人身份。非空时表示「以企业身份发帖」，
  // 卡片/详情页主标识切换为企业，但 authorId 仍指向真实操作者，便于审计/通知/对账。
  organizationId String?  @map("organization_id")
  title          String
  content        String
  type           PostType @default(DISCUSSION)
  videoUrl       String?  @map("video_url")
  imageUrl       String?  @map("image_url")
  views          Int      @default(0)
  likeCount      Int      @default(0) @map("like_count")
  commentCount   Int      @default(0) @map("comment_count")
  bookmarkCount  Int      @default(0) @map("bookmark_count")
  pinned         Boolean  @default(false)
  locked         Boolean  @default(false)
  // Stage 17.2：软删除。adminDelete / report resolution → 设置 deletedAt + deletedById；
  // 公开读路径必须过滤 deletedAt IS NULL；作者本人 /me/* 仍可见以发起申诉。
  deletedAt      DateTime? @map("deleted_at")
  deletedById    String?   @map("deleted_by_id")
  deletionReason String?   @map("deletion_reason")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  organization Organization? @relation("OrgPosts", fields: [organizationId], references: [id], onDelete: SetNull)
  deletedBy    User?         @relation("PostDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  comments     Comment[]
  likes        Like[]
  bookmarks    Bookmark[]

  @@index([channelId, createdAt])
  @@index([channelId, pinned, createdAt])
  @@index([authorId])
  @@index([type])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
  @@map("posts")
}

// ═════════════════════════════════════════════════════════════════
//                            Comments
// ═════════════════════════════════════════════════════════════════

model Comment {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  parentId  String?  @map("parent_id")
  content   String
  likeCount Int      @default(0) @map("like_count")
  // Stage 17.2：软删除
  deletedAt      DateTime? @map("deleted_at")
  deletedById    String?   @map("deleted_by_id")
  deletionReason String?   @map("deletion_reason")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   Comment[] @relation("CommentReplies")
  deletedBy User?     @relation("CommentDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  likes     Like[]

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([deletedAt])
  @@map("comments")
}

// ═════════════════════════════════════════════════════════════════
//                         Works (作品广场)
// ═════════════════════════════════════════════════════════════════

model Work {
  id             String       @id @default(cuid())
  authorId       String       @map("author_id")
  // Stage 11.3：企业身份发布作品
  organizationId String?      @map("organization_id")
  title          String
  description    String?
  videoUrl       String       @map("video_url")
  thumbnailUrl   String?      @map("thumbnail_url")
  category       WorkCategory @default(STORY)
  tools          String[]     @default([])
  model          WorkModel    @default(SEEDANCE_2_0)
  mode           WorkMode     @default(TEXT_TO_VIDEO)
  prompt         String?
  durationSec    Int?         @map("duration_sec")
  resolution     String?
  ratio          String?
  views          Int          @default(0)
  likeCount      Int          @default(0) @map("like_count")
  bookmarkCount  Int          @default(0) @map("bookmark_count")
  isPublic       Boolean      @default(true) @map("is_public")
  // Stage 17.2：软删除（adminDelete / report）。isPublic=false 是作者自选私密；deletedAt 才是合规下架。
  deletedAt      DateTime?    @map("deleted_at")
  deletedById    String?      @map("deleted_by_id")
  deletionReason String?      @map("deletion_reason")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  organization Organization? @relation("OrgWorks", fields: [organizationId], references: [id], onDelete: SetNull)
  deletedBy    User?         @relation("WorkDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  likes        Like[]
  bookmarks    Bookmark[]

  @@index([authorId])
  @@index([createdAt])
  @@index([category])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
  @@map("works")
}

// ═════════════════════════════════════════════════════════════════
//                  Collaboration (项目合作 / 接单)
// ═════════════════════════════════════════════════════════════════

model Collaboration {
  id             String                @id @default(cuid())
  authorId       String                @map("author_id")
  // Stage 11.3：企业身份发布合作。常见用例：企业 HR 招募 / 团队接单。
  organizationId String?               @map("organization_id")
  title          String
  description    String
  type           CollaborationType     @default(LOOKING_FOR)
  category       CollaborationCategory @default(OTHER)
  workMode       CollaborationWorkMode @default(PROJECT) @map("work_mode")
  location       CollaborationLocation @default(REMOTE)
  status         CollaborationStatus   @default(OPEN)
  budget         String?
  contact        String?
  deadline       DateTime?
  tags           String[]
  // Stage 17.2：软删除
  deletedAt      DateTime?             @map("deleted_at")
  deletedById    String?               @map("deleted_by_id")
  deletionReason String?               @map("deletion_reason")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  organization Organization? @relation("OrgCollaborations", fields: [organizationId], references: [id], onDelete: SetNull)
  deletedBy    User?         @relation("CollaborationDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([category])
  @@index([type])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
  @@map("collaborations")
}

// ═════════════════════════════════════════════════════════════════
//                Tools (AI 视频工具库) + Workflow Market
// ═════════════════════════════════════════════════════════════════

model Tool {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  url         String
  category    String
  useCase     String?     @map("use_case")
  logoUrl     String?     @map("logo_url")
  pricing     ToolPricing @default(FREE)
  tags        String[]
  isOfficial  Boolean     @default(false) @map("is_official")
  createdById String?     @map("created_by_id")
  // 阶段 8：评分聚合（写入时维护，避免读路径再 group by）
  avgRating   Float?      @map("avg_rating")
  ratingCount Int         @default(0) @map("rating_count")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  createdBy User?        @relation("ToolContributor", fields: [createdById], references: [id], onDelete: SetNull)
  ratings   ToolRating[]

  @@index([category])
  @@map("tools")
}

/// 阶段 8：工具评分（一个用户对一个工具只能有一条记录）
model ToolRating {
  id        String   @id @default(cuid())
  toolId    String   @map("tool_id")
  userId    String   @map("user_id")
  stars     Int // 1-5；上层校验
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolId, userId])
  @@index([toolId, createdAt])
  @@index([userId])
  @@map("tool_ratings")
}

/// 工作流商品（用户可上架/售卖 ComfyUI / 节点图 / Prompt 包等）
model WorkflowItem {
  id             String             @id @default(cuid())
  sellerId       String             @map("seller_id")
  // Stage 11.3：以企业身份上架商品。收款仍记到 sellerId（操作者），
  // 卡片/详情页主标识切换为企业，结算单 Payout 仍按 sellerId 计入个人收益。
  // MVP 暂不做「企业账户结算」，只做「企业品牌展示」。
  organizationId String?            @map("organization_id")
  title          String
  description    String
  coverUrl       String?            @map("cover_url")
  downloadUrl    String?            @map("download_url")
  priceCents     Int                @default(0) @map("price_cents")
  currency       String             @default("CNY")
  category       String
  tags           String[]           @default([])
  toolStack      String[]           @default([]) @map("tool_stack")
  salesCount     Int                @default(0) @map("sales_count")
  status         WorkflowItemStatus @default(DRAFT)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  seller       User          @relation("WorkflowItemSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  organization Organization? @relation("OrgWorkflowItems", fields: [organizationId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@index([sellerId])
  @@index([status, createdAt])
  @@index([category])
  @@index([organizationId, createdAt])
  @@map("workflow_items")
}

// ═════════════════════════════════════════════════════════════════
//                  Messaging (一对一 / 群聊 私信)
// ═════════════════════════════════════════════════════════════════

/// 群聊角色（Stage 12.1）。1v1 会话所有参与者默认 MEMBER；群聊 OWNER 唯一，
/// 可由 OWNER 提拔 ADMIN（Stage 12.2）。
enum ConversationRole {
  OWNER
  ADMIN
  MEMBER
}

/// 消息类型（Stage 12.1）。TEXT 为默认；IMAGE/FILE 由 Stage 12.3 附件管道使用；
/// SYSTEM 用于「XX 加入了群聊 / XX 修改了群名」等系统通知。
enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

model Conversation {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now()) @map("created_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  // Stage 12.1：群聊扩展。1v1 isGroup=false / title=null / ownerId=null / memberLimit=2；
  // 群聊 isGroup=true / title=群名 / avatarUrl=群头像 / ownerId=群主 / memberLimit 默认 100。
  isGroup     Boolean @default(false) @map("is_group")
  title       String?
  avatarUrl   String? @map("avatar_url")
  ownerId     String? @map("owner_id")
  memberLimit Int     @default(2) @map("member_limit")

  participants ConversationParticipant[]
  messages     Message[]
  owner        User?                     @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([lastMessageAt])
  @@index([isGroup, lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  lastReadAt     DateTime @default(now()) @map("last_read_at")

  // Stage 12.1：群聊角色 + 免打扰。1v1 全部 MEMBER；群聊由 OWNER/ADMIN 管理。
  role       ConversationRole @default(MEMBER)
  mutedUntil DateTime?        @map("muted_until")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  content        String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Stage 12.1：消息类型 + 附件 JSON + 编辑/删除时间戳。
  // attachments 形如 [{ url, name, mimeType, sizeBytes, width?, height? }]，由 Stage 12.3 写入；
  // SYSTEM 消息的 senderId = 触发者（如加群者本人）。
  type        MessageType @default(TEXT)
  attachments Json?
  editedAt    DateTime?   @map("edited_at")
  deletedAt   DateTime?   @map("deleted_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ═════════════════════════════════════════════════════════════════
//                       Follow (关注关系)
// ═════════════════════════════════════════════════════════════════

/// 关注关系：followerId 关注 followingId。同一对人只能有一条记录。
model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
  @@map("follows")
}

// ═════════════════════════════════════════════════════════════════
//                   Engagement (点赞 / 收藏)
// ═════════════════════════════════════════════════════════════════

/// 多态点赞：post / work / comment 三选一，由可空外键 + DB 唯一约束保证
model Like {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String?  @map("post_id")
  workId    String?  @map("work_id")
  commentId String?  @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  work    Work?    @relation(fields: [workId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, workId])
  @@unique([userId, commentId])
  @@map("likes")
}

/// 多态收藏：post / work 二选一
model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  postId    String?  @map("post_id")
  workId    String?  @map("work_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  work Work? @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, workId])
  @@map("bookmarks")
}

// ═════════════════════════════════════════════════════════════════
//             Notification / Report / AuditLog (管理后台)
// ═════════════════════════════════════════════════════════════════

model Notification {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  body       String?
  link       String?
  actorId    String?          @map("actor_id")
  targetType String?          @map("target_type")
  targetId   String?          @map("target_id")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, actorId, type, targetType, targetId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Stage 9：通知偏好。缺省即开启，关闭某类型后 emitNotification 跳过对应 type。
model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String           @map("reporter_id")
  targetType   ReportTargetType @map("target_type")
  targetId     String           @map("target_id")
  reason       String
  description  String?
  status       ReportStatus     @default(PENDING)
  resolvedById String?          @map("resolved_by_id")
  resolvedAt   DateTime?        @map("resolved_at")
  resolution   String?
  // Stage 17.1：MOD 队列认领。PENDING 时 assignedToId 为空；
  // MOD/ADMIN 认领后置 REVIEWING 并写 assignedToId/assignedAt；resolve/dismiss 时清空。
  assignedToId String?   @map("assigned_to_id")
  assignedAt   DateTime? @map("assigned_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  assignedTo User? @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([assignedToId, status])
  @@map("reports")
}

/// Stage 17.2：内容申诉。作者对自己被软删除的 Post/Work/Comment/Collaboration 提出申诉。
/// 多态 polymorphic：targetId 不走 FK（已删内容仍能引用）。
/// 同一 (targetType, targetId) 在任意时点只允许一条 PENDING（部分唯一索引 raw SQL 实现）。
model ContentAppeal {
  id           String                  @id @default(cuid())
  appellantId  String                  @map("appellant_id")
  targetType   ContentAppealTargetType @map("target_type")
  targetId     String                  @map("target_id")
  reason       String // 10-1000 字
  status       ContentAppealStatus     @default(PENDING)
  reviewNote   String?                 @map("review_note") // admin 审核备注（REJECTED 必填）
  reviewedById String?                 @map("reviewed_by_id")
  reviewedAt   DateTime?               @map("reviewed_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  appellant  User  @relation("AppealAppellant", fields: [appellantId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("AppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([appellantId, createdAt])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("content_appeals")
}

/// 后台管理员操作审计；action 用大写下划线字符串（如 "DELETE_POST" / "BAN_USER"）
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation("AuditAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ═════════════════════════════════════════════════════════════════
//      Commerce (会员 / 订阅 / 订单) — 商业化扩展 stub
// ═════════════════════════════════════════════════════════════════

model MembershipPlan {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  priceCents  Int          @map("price_cents")
  currency    String       @default("CNY")
  cycle       BillingCycle @default(MONTHLY)
  features    String[]     @default([])
  trialDays   Int          @default(0) @map("trial_days") // 阶段 10：试用天数
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  subscriptions Subscription[]
  orders        Order[]

  @@index([isActive, sortOrder])
  @@map("membership_plans")
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @map("user_id")
  planId           String             @map("plan_id")
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now()) @map("started_at")
  currentPeriodEnd DateTime           @map("current_period_end")
  canceledAt       DateTime?          @map("canceled_at")
  externalId       String?            @map("external_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MembershipPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Order {
  id              String         @id @default(cuid())
  userId          String         @map("user_id")
  orderNo         String         @unique @map("order_no")
  type            OrderType
  status          OrderStatus    @default(PENDING)
  amountCents     Int            @map("amount_cents")
  currency        String         @default("CNY")
  planId          String?        @map("plan_id")
  workflowItemId  String?        @map("workflow_item_id")
  paymentMethod   PaymentMethod? @map("payment_method")
  // 阶段 10：支付凭据与退款
  transactionId   String?        @map("transaction_id") // 第三方支付订单号
  callbackPayload Json?          @map("callback_payload") // 验签后保存的回调原文
  paidAt          DateTime?      @map("paid_at")
  expiresAt       DateTime?      @map("expires_at") // 订单超时时间，超过自动 CANCELED
  refundCents     Int            @default(0) @map("refund_cents") // 累计退款金额（分），支持部分退款
  refundReason    String?        @map("refund_reason")
  refundedAt      DateTime?      @map("refunded_at")
  refundedById    String?        @map("refunded_by_id") // 操作退款的 admin id
  // 阶段 16.2：客户端幂等键，防止双击 / 网络重试创建重复订单。
  // 同 (userId, clientNonce) 复合唯一；NULL 不参与约束（PG NULL ≠ NULL 语义），
  // 旧路径不传 nonce 时降级为非幂等的允许行为。
  clientNonce     String?        @map("client_nonce")
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           MembershipPlan?   @relation(fields: [planId], references: [id])
  workflowItem   WorkflowItem?     @relation(fields: [workflowItemId], references: [id])
  payout         Payout?
  refunds        Refund[]
  clawbacks      ClawbackRequest[]
  downloadGrants DownloadGrant[]

  @@unique([userId, clientNonce])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([type])
  @@index([status, expiresAt])
  @@map("orders")
}

/// 阶段 10.4：退款记录。一笔订单可以有多次部分退款 → 多行；累计金额回写到 Order.refundCents。
/// 每行对应一次对 PSP 的 refund 调用；out_refund_no / out_request_no = `R{id}`，保证 PSP 端幂等。
model Refund {
  id               String       @id @default(cuid())
  orderId          String       @map("order_id")
  amountCents      Int          @map("amount_cents")
  reason           String?
  status           RefundStatus @default(PENDING)
  providerResponse Json?        @map("provider_response")
  providerError    String?      @map("provider_error")
  createdById      String       @map("created_by_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  finishedAt       DateTime?    @map("finished_at")

  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User             @relation("RefundCreator", fields: [createdById], references: [id], onDelete: Cascade)
  clawback  ClawbackRequest?

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("refunds")
}

/// 阶段 16.4：已分润后退款的应收。
/// 触发条件：refundOrder SUCCESS 时，关联 Payout 已是 PAID → 卖家已实际收到这笔钱，
/// 但买家要回去了 → 平台垫资。建一行 PENDING ClawbackRequest 让 ops 追讨 / 扣减下次结算。
///
/// 设计选择：本表只「记录欠款」，不强制自动扣减。
/// - 自动从下次 payout.netCents 扣是更激进的设计，但有合理性边界（同一卖家可能开了多个店、
///   平台政策也可能允许部分豁免），MVP 让 ops 手动决策，记录在本表 status + note 留痕。
/// - 卖家从未来某笔 payout 抵扣 → admin 在 /admin/clawbacks 标记 DEDUCTED + note 写抵扣的 payout id。
///
/// 严格地 refundId @unique：一次 Refund SUCCESS 至多产生一条 Clawback 行。
/// payoutId 不唯一：同一 Payout 可能对应多次部分退款（虽然实际很罕见）。
model ClawbackRequest {
  id           String         @id @default(cuid())
  refundId     String         @unique @map("refund_id")
  payoutId     String         @map("payout_id")
  sellerId     String         @map("seller_id")
  orderId      String         @map("order_id")
  orderNo      String         @map("order_no")
  amountCents  Int            @map("amount_cents")
  currency     String         @default("CNY")
  status       ClawbackStatus @default(PENDING)
  note         String?
  createdAt    DateTime       @default(now()) @map("created_at")
  resolvedAt   DateTime?      @map("resolved_at")
  resolvedById String?        @map("resolved_by_id")

  refund     Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  payout     Payout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller     User   @relation("ClawbackSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("ClawbackResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@map("clawback_requests")
}

/// 阶段 10：创作者收益结算单。每个 PAID 订单生成一条；7 日确认期后变 AVAILABLE 可结算。
/// Stage 10.5：加 requestedAt / paidBy / 收款快照，承载「卖家申请提现 → admin 线下打款」流程。
model Payout {
  id               String       @id @default(cuid())
  orderId          String       @unique @map("order_id")
  sellerId         String       @map("seller_id")
  grossCents       Int          @map("gross_cents") // 订单金额
  platformFeeCents Int          @map("platform_fee_cents") // 平台抽成
  netCents         Int          @map("net_cents") // 实际可结算
  currency         String       @default("CNY")
  status           PayoutStatus @default(PENDING)
  availableAt      DateTime     @map("available_at") // 确认期结束时间
  // Stage 10.5：提现申请
  requestedAt      DateTime?    @map("requested_at") // 卖家点「申请提现」时间；与 AVAILABLE 一同筛选可看出待处理队列
  // Stage 10.5：admin 标记打款时的快照
  paidAt           DateTime?    @map("paid_at")
  paidById         String?      @map("paid_by_id") // 操作 admin id
  paidMethod       String?      @map("paid_method") // 打款时快照（ALIPAY / WECHAT_PAY / BANK）
  paidAccount      String?      @map("paid_account") // 打款时快照账号
  paidName         String?      @map("paid_name") // 打款时快照姓名
  paidNote         String?      @map("paid_note") // admin 备注（流水号 / 备忘）
  metadata         Json?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller    User              @relation("PayoutSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  clawbacks ClawbackRequest[]

  @@index([sellerId, status])
  @@index([status, availableAt])
  @@index([sellerId, requestedAt])
  @@map("payouts")
}

/// 阶段 16.1：支付回调幂等表。每个第三方网关投递的 webhook 在被处理前先 upsert 此表，
/// 复合唯一 (provider, providerEventId) 保证重复投递只命中一次 markOrderPaid。
///
/// providerEventId 来源：
///   - MOCK：`${orderNo}|${transactionId}|${paidAt.toISOString()}`（mockProvider 的 signed canonical 决定确定性）
///   - WECHAT_PAY：top-level body.id（v3 通知的 unique ID）
///   - ALIPAY：params.notify_id（异步通知的 unique ID）
///
/// 为什么用单独的表而不是 Order 字段：
///   1. 同一订单可能收到 ORDER_PAID + 后续 REFUNDED 多类事件，不能用 orderNo 单字段去重。
///   2. webhook 早于业务表 markOrderPaid，dedup 必须在 PSP 验签后、业务处理前完成。
///   3. 表作为 ops 审计源（"我们到底收到过这条 webhook 吗？"），独立于 Order 生命周期。
///
/// rawBodyHash 用于事后取证（与 PSP 重发对账时确认 body 字节级一致），不参与去重。
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String // MOCK / WECHAT_PAY / ALIPAY
  providerEventId String    @map("provider_event_id")
  orderNo         String?   @map("order_no")
  eventType       String    @map("event_type") // ORDER_PAID / ORDER_REFUNDED / UNKNOWN
  rawBodyHash     String    @map("raw_body_hash") // sha256(raw) hex
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at") // markOrderPaid 完成时间；null = 验签通过但业务处理失败 / 跳过

  @@unique([provider, providerEventId])
  @@index([orderNo])
  @@index([receivedAt])
  @@map("webhook_events")
}

/// Stage 16.5：付费下载 redeem 审计日志。
///
/// 不参与签名验证本身（HMAC 完全无状态），只记录每次成功 GET 兑换：方便事后排查滥用
/// （"同一 IP 1 小时拉了 100 次"、"refund 后还在尝试"等）+ 给运营提供量化指标。
///
/// 关键不变量：本表只在 redeem 成功后写一行；token 验签失败 / 订单已 refund / 文件未配置
/// 都不会留下 grant 记录（错误已通过 401/403/404 暴露给客户端）。
model DownloadGrant {
  id            String   @id @default(cuid())
  orderId       String   @map("order_id")
  userId        String   @map("user_id")
  tokenNonce    String   @map("token_nonce")
  issuedAt      DateTime @map("issued_at")
  expiresAt     DateTime @map("expires_at")
  redeemedAt    DateTime @default(now()) @map("redeemed_at")
  ip            String?
  userAgentHash String?  @map("user_agent_hash")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation("DownloadGrantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId, redeemedAt(sort: Desc)])
  @@index([userId, redeemedAt(sort: Desc)])
  @@map("download_grants")
}

// ═════════════════════════════════════════════════════════════════
//                  Organization (企业账号) stub
// ═════════════════════════════════════════════════════════════════

model Organization {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  logo        String?
  website     String?
  isVerified  Boolean @default(false) @map("is_verified")

  // Stage 11.1：基础企业属性 + 创建者
  ownerId      String  @map("owner_id")
  industry     String? // 行业（影视 / 游戏 / 广告 / 自媒体 / 其他）
  size         String? // 规模（1-10 / 11-50 / 51-200 / 201+）
  contactEmail String? @map("contact_email")

  // Stage 11.2：企业认证。verificationStatus 与 isVerified 由审核动作同步：APPROVED ⇒ isVerified=true，
  // 其他状态对 isVerified 不做隐式修改（admin 可手动改）。提交资料字段为 nullable，未提交时为空。
  verificationStatus      OrgVerificationStatus @default(NONE) @map("verification_status")
  verificationName        String?               @map("verification_name") // 营业执照上的法定企业名称
  verificationRegNo       String?               @map("verification_reg_no") // 统一社会信用代码 / 注册号
  verificationRep         String?               @map("verification_rep") // 法定代表人姓名
  verificationLicenseUrl  String?               @map("verification_license_url") // 营业执照扫描件 URL
  verificationContact     String?               @map("verification_contact") // 申请方联系电话 / 邮箱
  verificationNote        String?               @map("verification_note") // 申请方补充说明
  verificationReviewNote  String?               @map("verification_review_note") // 管理员审核结论 / 驳回原因
  verificationSubmittedAt DateTime?             @map("verification_submitted_at")
  verificationReviewedAt  DateTime?             @map("verification_reviewed_at")
  verificationReviewedBy  String?               @map("verification_reviewed_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner             User                 @relation("OrganizationOwner", fields: [ownerId], references: [id])
  verificationAdmin User?                @relation("OrgVerificationReviewer", fields: [verificationReviewedBy], references: [id])
  members           OrganizationMember[]
  invites           OrganizationInvite[]

  // Stage 11.3：企业归属的内容（以企业身份发布）
  posts          Post[]          @relation("OrgPosts")
  works          Work[]          @relation("OrgWorks")
  collaborations Collaboration[] @relation("OrgCollaborations")
  workflowItems  WorkflowItem[]  @relation("OrgWorkflowItems")

  @@index([ownerId])
  @@index([verificationStatus, verificationSubmittedAt])
  @@map("organizations")
}

model OrganizationMember {
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// Stage 11.1：邀请加入企业。同一 inviteeId 对同一 org 最多一条 PENDING 行（业务层保证 + 部分唯一索引）。
model OrganizationInvite {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  inviterId      String          @map("inviter_id")
  inviteeId      String          @map("invitee_id")
  role           OrgRole         @default(MEMBER)
  status         OrgInviteStatus @default(PENDING)
  message        String?
  createdAt      DateTime        @default(now()) @map("created_at")
  respondedAt    DateTime?       @map("responded_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("OrgInviteInviter", fields: [inviterId], references: [id])
  invitee      User         @relation("OrgInviteInvitee", fields: [inviteeId], references: [id])

  @@index([organizationId, status])
  @@index([inviteeId, status])
  @@map("organization_invites")
}
